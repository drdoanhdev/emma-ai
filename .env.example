# Copy this file to .env.local and fill in real values.
# Never commit .env.local.
#
# On Vercel: Project → Settings → Environment Variables → add the same keys.

OPENAI_API_KEY=

# Realtime API cost controls (optional — defaults shown)
# REALTIME_MODEL=gpt-realtime
# REALTIME_VOICE=coral
# REALTIME_MAX_OUTPUT_TOKENS=50
# REALTIME_POST_INSTRUCTIONS=1200
# REALTIME_RETENTION_RATIO=0.8
# REALTIME_COMPACT_EVERY_TURNS=10
# REALTIME_KEEP_TURNS=5
# REALTIME_ROTATE_MINUTES=5
# REALTIME_PROMPT_BUDGET=600

# Upstash Redis / Vercel KV — dùng một trong hai cặp tên biến:
# (Vercel KV thường inject KV_REST_API_*)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Hoặc tên native Upstash:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
